# Шлях репозиторію на GitHub Pages (порожньо для власного домену)
NEXT_PUBLIC_BASE_PATH=/lending-for-doctor

# Публічна адреса сайту разом із шляхом — для canonical, sitemap, OG і JSON-LD
NEXT_PUBLIC_SITE_URL=https://w1teen8.github.io/lending-for-doctor

# true: концепт (noindex, плашка «концепт», форми нічого не надсилають). false: робочий сайт
NEXT_PUBLIC_CONCEPT=true

# HTTPS-адреса, що приймає заявки (див. worker/lead.ts). Порожньо = демо-режим форм
NEXT_PUBLIC_LEAD_ENDPOINT=

# GA4 Measurement ID. Порожньо — аналітика не підключається
NEXT_PUBLIC_GA_ID=
